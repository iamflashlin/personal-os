#!/bin/sh
# Reject direct pushes to main: every change must land through a pull request.
# Enabled per clone with: git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct push to main is blocked. Push a branch and open a PR." >&2
    exit 1
  fi
done
exit 0
