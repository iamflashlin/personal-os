{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run python -m tools.check)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format --check *)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run test)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "PowerShell(uv run python -m tools.check)",
      "PowerShell(uv run pytest *)",
      "PowerShell(uv run ruff check *)",
      "PowerShell(uv run ruff format --check *)",
      "PowerShell(pnpm run typecheck)",
      "PowerShell(pnpm run test)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh run view *)",
      "Bash(git push -u origin t/*)",
      "Bash(git push -u origin d0/*)",
      "Bash(gh pr create *)",
      "PowerShell(git push -u origin t/*)",
      "PowerShell(git push -u origin d0/*)",
      "PowerShell(gh pr create *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(pnpm add *)",
      "PowerShell(uv add *)",
      "PowerShell(pnpm add *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "PowerShell(Get-Content *.env*)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *+main*)",
      "Bash(git push *--delete*)",
      "Bash(git push * :*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config --unset core.hooksPath*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -f*)",
      "Bash(rm --recursive*)",

      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *--no-verify*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push *+main*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push * :*)",
      "PowerShell(git commit *--no-verify*)",
      "PowerShell(git -c core.hooksPath*)",
      "PowerShell(git config core.hooksPath*)",
      "PowerShell(git config --unset core.hooksPath*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git branch -d*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(Remove-Item * -r*)",
      "PowerShell(Remove-Item -r*)",
      "PowerShell(cmd /c rd *)",
      "PowerShell(cmd /c rmdir *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(Set-ExecutionPolicy *)"
    ]
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  }
}
